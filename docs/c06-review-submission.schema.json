{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c06-review-submission-v1",
  "title": "c06 structured independent-review submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "freeze_commit",
    "scope_sha256",
    "verdict",
    "summary",
    "contradictions",
    "not_found",
    "blockers"
  ],
  "properties": {
    "freeze_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "scope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "BLOCK"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "contradictions": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "not_found": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "evidence"],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "line_start", "line_end", "quote"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "verdict": { "const": "PASS" } },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "contradictions": { "maxItems": 0 },
          "not_found": { "maxItems": 0 },
          "blockers": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "verdict": { "const": "BLOCK" } },
        "required": ["verdict"]
      },
      "then": {
        "anyOf": [
          { "properties": { "contradictions": { "minItems": 1 } } },
          { "properties": { "not_found": { "minItems": 1 } } },
          { "properties": { "blockers": { "minItems": 1 } } }
        ]
      }
    }
  ]
}
